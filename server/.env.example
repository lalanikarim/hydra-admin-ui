# Hydra Admin Server — Environment
# Copy to .env and fill in values: cp .env.example .env

# ─── Hydra Servers (JSON array) ─────────────────────────────────────────────
# Define one or more Hydra admin servers.
# "name" is the routing key used in URLs: /h/{name}/clients
HYDRA_SERVERS=[{"name":"prod","label":"Production","environment":"prod","url":"http://hydra.ory.svc.cluster.local:4445","description":"Primary production Hydra"}]

# Alternative: single server (legacy, treated as name="default")
# HYDRA_ADMIN_URL=http://localhost:4445

# ─── Server ─────────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# ─── Authentication (REQUIRED — server won't start without these) ──────────

# Shared admin token
# Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me

# TOTP base32 secret (for your authenticator app)
# Generate: cd server && node -e "console.log(require('otplib').generateSecret({length:20}))"
# Then scan: otpauth://totp/HydraAdmin:admin?secret=<VALUE>&issuer=HydraAdmin
ADMIN_TOTP_SECRET=change-me

# Session cookie TTL in hours
SESSION_HOURS=8
