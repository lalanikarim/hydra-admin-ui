# Hydra Admin UI — Environment Configuration

# Hydra admin API URL (internal K8s service or localhost)
HYDRA_ADMIN_URL=http://localhost:4445

# Server port
PORT=3001

# Environment: 'development' or 'production'
NODE_ENV=development

# ─── Authentication (REQUIRED) ──────────────────────────────────────────────
# Shared admin token (something you know)
# Generate: openssl rand -hex 32
ADMIN_TOKEN=your-admin-token-here

# TOTP base32 secret (something you have — authenticator app)
# Generate: npx otplib -g  (or: node -e "console.log(require('otplib').generateSecret({length:20}))")
# Then scan the otpauth:// URI in Google Authenticator / 1Password
ADMIN_TOTP_SECRET=your-base32-totp-secret-here

# Session cookie TTL in hours
SESSION_HOURS=8
